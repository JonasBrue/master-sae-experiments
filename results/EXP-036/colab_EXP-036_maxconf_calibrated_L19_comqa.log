# Source: night_experiments.md
# Code cell:
#   # ════════════════════════════════════════════════════════════════════════════════
#   # EXP 36: Calibrated max_confidence — CommonsenseQA L19
#   # ════════════════════════════════════════════════════════════════════════════════
#   # Session 1 quantile mapping for CommonsenseQA:
#   #   p_correct < 0.10 → 16.6% of questions → mc < 0.702
#   #   p_correct < 0.35 → 25.2% of questions → mc < 0.831
#   #   p_correct < 0.50 → 29.0% of questions → mc < 0.873
#   #
#   # So calibrated step thresholds: p_min=0.70, p_sweet=0.83, p_max=0.87
#   # Compare to EXP 13 (max_confidence with uncalibrated [0.10, 0.35, 0.50] → terrible)
#   # Compare to EXP 02 (p_correct with [0.10, 0.35, 0.50] → full adapt +0.8%)
#
#   run_experiment(
#       "exp36_maxconf_calibrated_L19_comqa",
#       BASE_CMD + LLAMA + SAE_L19 + COMQA +
#       "--set causal.adaptive.enabled=True "
#       "--set causal.adaptive.mode=step "
#       "--set causal.adaptive.difficulty_metric=max_confidence "
#       "--set causal.adaptive.p_min=0.70 "
#       "--set causal.adaptive.p_sweet=0.83 "
#       "--set causal.adaptive.p_max=0.87 "
#       "--set causal.adaptive.transition_strength=0.3 "
#       "--set causal.min_p_correct=0.15 "
#       "--set causal.max_p_correct=0.45"
#   )


