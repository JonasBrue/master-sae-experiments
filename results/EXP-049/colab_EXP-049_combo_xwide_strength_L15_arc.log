#   # discovery + the strength grid can push even further.
#   # ARC's default filter only gives 48 test questions — xwide should give ~89.
#   # Compare to: EXP 29 (default, λ=2.0 → +1.3%) and EXP 35 (xwide, λ=1.0 → +0.8%)
#
#   run_experiment(
#       "exp49_combo_xwide_strength_L15_arc",
#       BASE_CMD + LLAMA + SAE_L15 + ARC + ADAPTIVE_STEP + " "
#       "--set causal.min_p_correct=0.05 "
#       "--set causal.max_p_correct=0.55 " +
#       STRENGTH_GRID
#   )


