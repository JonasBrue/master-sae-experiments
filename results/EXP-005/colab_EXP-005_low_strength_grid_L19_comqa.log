#   # ════════════════════════════════════════════════════════════════════════════════
#   # EXP 5: Lower Strength Grid — CommonsenseQA + BatchTopK L19 K32
#   # ════════════════════════════════════════════════════════════════════════════════
#   # Purpose: Test if very low uniform strength (0.1-0.3) can improve full benchmark
#   #          by helping hard questions slightly without hurting medium ones.
#   # Key insight: Current grid only tests [0.5, 1.0]. Lower values untested.
#
#   run_experiment(
#       "exp05_low_strength_grid_L19_comqa",
#       "python -m sae_experiments "
#       "--model configs/models/llama31_8b.yaml "
#       "--sae configs/saes/batchtopk_llama_l19_k32.yaml "
#       "--benchmark configs/benchmarks/commonsenseqa.yaml "
#       f"--output-dir {RESULTS_DIR} "
#       "--batch-size 32 "
#       "--set causal.min_p_correct=0.15 "
#       "--set causal.max_p_correct=0.45 "
#       "--set 'grid.strength=[0.1,0.2,0.3,0.5,1.0]'"
#   )


