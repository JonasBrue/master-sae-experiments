# Code cell:
#   # ════════════════════════════════════════════════════════════════════════════════
#   # EXP 48: Combination — XWide Filter + Strength Grid — CommonsenseQA L19
#   # ════════════════════════════════════════════════════════════════════════════════
#   # Session 1 found TWO independent winners:
#   #   - EXP 31: xwide filter [0.05, 0.55] → best full-benchmark delta (+1.0%)
#   #   - EXP 26: strength 2.0 → best filtered delta (+24.8%)
#   # These were never combined. XWide filter found 33/50 (66%) causal features
#   # with higher min_occurrences (9 vs 4), so the features are more robust.
#   # Higher strength on more robust features could break the ~1% ceiling.
#   # Compare to: EXP 31 (xwide, λ=1.0 → +1.0%) and EXP 26 (default, λ=2.0 → +0.9%)
#
#   run_experiment(
#       "exp48_combo_xwide_strength_L19_comqa",
#       BASE_CMD + LLAMA + SAE_L19 + COMQA + ADAPTIVE_STEP + " "
#       "--set causal.min_p_correct=0.05 "
#       "--set causal.max_p_correct=0.55 " +
#       STRENGTH_GRID
#   )


